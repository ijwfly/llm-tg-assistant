# Copy to .env. Used by docker-compose (variables) and passed into the bot container (env_file).
TELEGRAM_BOT_TOKEN=
ALLOWED_USERS=123456789            # comma-separated Telegram user ids
NOTIFY_CHAT=                       # chat_id or chat_id:thread_id, optional

# Host paths mounted into the container at the same absolute paths, so sessions started
# in a terminal and in the bot share one transcript folder per project (both required)
WORK_ROOT=/home/me/src             # root of your projects; the bot never leaves it
CLAUDE_HOME=/home/me/.claude       # transcripts, OAuth credentials, settings.json
GITCONFIG=/home/me/.gitconfig

# Run the container as your host user so edited files keep your ownership
UID=1000
GID=1000

# Database
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Only if you don't use a Claude subscription login from CLAUDE_HOME
# ANTHROPIC_API_KEY=
