# Copy to docker-compose.override.yml (gitignored). Compose merges it automatically.
services:
  bot:
    # Keep the container alive and run the app by hand:
    #   docker compose exec bot python -m app.main
    entrypoint: ["sh", "-c", "while true; do sleep 3600; done"]
    volumes:
      - .:/app

  db:
    ports:
      - "5432:5432"

  adminer:
    image: adminer
    ports:
      - "8080:8080"
    depends_on:
      - db
